{
  "name": "gate-digital-twin-viewer",
  "version": "1.0.0",
  "description": "Gate Digital Twin Viewer — industrial gate 3D product knowledge desktop app",
  "main": "dist-electron/main.js",
  "author": "Gate Digital Twin",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "package": "node scripts/package-desktop.mjs",
    "package:exe": "npm run build && electron-builder --win dir --x64 && node scripts/copy-root-exe.mjs",
    "package:portable": "npm run build && electron-builder --win portable --x64 && node scripts/copy-root-exe.mjs",
    "package:mac": "npm run build && electron-builder --mac dir && node scripts/copy-root-app.mjs",
    "preview": "vite preview",
    "generate:model": "node scripts/generate-placeholder-glb.mjs",
    "convert:stp": "node scripts/convert-stp-to-glb.mjs"
  },
  "dependencies": {
    "occt-import-js": "^0.0.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.company.gatedigitaltwin",
    "productName": "Gate Digital Twin Viewer",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/occt-import-js/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/occt-import-js/**/*"
    ],
    "extraResources": [
      {
        "from": "public/models",
        "to": "models"
      },
      {
        "from": "public/data",
        "to": "data"
      },
      {
        "from": "public/documents",
        "to": "documents"
      },
      {
        "from": "node_modules/occt-import-js/dist",
        "to": "occt-import-js"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "GateDigitalTwinViewer-${version}-${arch}.${ext}",
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "GateDigitalTwinViewer.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "gatekeeperAssess": false,
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "GateDigitalTwinViewer-${version}-${arch}.${ext}"
    }
  }
}
